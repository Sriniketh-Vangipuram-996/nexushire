{
  "compilerOptions": {
    "target": "ES2020",
    "skipLibCheck": true,
    "types": ["node"],
    "module": "CommonJS",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "typeRoots": ["./node_modules/@types", "src/api/v1/types"]
  },
  "include": ["src/**/*","tests/**/*"],
}